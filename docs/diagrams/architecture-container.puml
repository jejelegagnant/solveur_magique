@startuml architecture-container
skinparam shadowing false
skinparam componentStyle rectangle
skinparam package {
  BackgroundColor #F8FAFC
  BorderColor #334155
}
skinparam node {
  BackgroundColor #EFF6FF
  BorderColor #1D4ED8
}
skinparam database {
  BackgroundColor #ECFDF5
  BorderColor #047857
}

title Solveur Magique (V1.0.0) — System Container Architecture (100% Swiss Sovereign)

actor "Team Manager /\nSME Owner" as Manager
actor "Institution Director" as Director
actor "Staff Member\n(Pro / Business)" as Staff

package "External Services (Non-PII / Bridges)" {
  [Stripe Switzerland\n(CHF Cards & TWINT)] as Stripe
  [Legacy ERP\n(Polypoint / Abacus / Bexio / Excel)] as ERP
}

node "Infomaniak Swiss Cloud — Geneva / Zurich (ISO 27001, Outside US CLOUD Act)" {

  component "Caddy 2 Reverse Proxy\n(TLS 1.3, CSP, Rate Limit)" as Caddy

  component "React 19 + TS + Vite SPA\n(Monthly Matrix Grid, Pinning,\nFR/DE/EN i18n, Mobile Wish Portal)" as SPA

  package "FastAPI Modular Monolith (Python 3.12)" {
    [Auth & RBAC Module\n(Argon2id, HttpOnly JWT,\nZero-PII Sandbox)] as AuthMod
    [Scheduling & Config API\n(Shifts, Coverage, Staff,\nLTr/OLT 2/L-GAV Presets)] as SchedMod
    [Export & Document Service\n(openpyxl .xlsx, CSV, WeasyPrint PDF,\nPack Direction, iCal .ics)] as ExportMod
    [Billing & Compliance Module\n(Stripe Webhooks, Swiss QR-Bill,\n5-Yr Archive, Audit Log)] as BillingMod
  }

  queue "Redis 7\n(Job Queues: solver_fast / solver_paid\n+ Pub/Sub Progress)" as Redis

  package "Async Solver Worker Pool (CPU-Isolated)" {
    [Dramatiq / Celery Workers] as Worker
    [solver_core (Pure Python)\nGoogle OR-Tools CP-SAT\n+ Infeasibility Explainer] as SolverCore
  }

  database "PostgreSQL 16\n(Multi-Tenant RLS,\nJSONB Snapshots,\nAudit Logs)" as PG

  storage "Infomaniak Swiss Backup S3\n(AES-256 Daily + WAL Backups,\n5-Yr Legal Archives)" as S3

  [Infomaniak SMTP Relay\n(Swiss Transactional Mail)] as SMTP
  [Self-Hosted Observability\n(Prometheus + GlitchTip,\nPII-Scrubbed)] as Obs
}

' === User Traffic ===
Manager --> Caddy : HTTPS (TLS 1.3)
Director --> Caddy : HTTPS (TLS 1.3)
Staff --> Caddy : HTTPS (Mobile Wish Link)

Caddy --> SPA : Static Assets
Caddy --> AuthMod : /api/auth, /api/sandbox
Caddy --> SchedMod : /api/teams, /api/schedules
Caddy --> ExportMod : /api/exports, /api/pack-direction
Caddy --> BillingMod : /api/billing

' === Internal Interactions ===
AuthMod --> PG : RLS Context
SchedMod --> PG : Read/Write Domain State
ExportMod --> PG : Read Schedule Snapshots
BillingMod --> PG : Subscriptions, DPA, Audit

SchedMod --> Redis : Enqueue SolverJob (JSON Snapshot)
Redis --> Worker : Dequeue Job (Tier Timeout Cap)
Worker --> SolverCore : Build & Solve CP-SAT
Worker --> PG : Persist Draft / Conflict Cards
Worker --> Redis : Publish Completion Event

PG --> S3 : Encrypted WAL & Daily Snapshots
BillingMod --> S3 : Immutable 5-Yr Archives (Art. 46 LTr)

' === External Boundaries ===
BillingMod --> Stripe : CHF Checkout & Webhooks
BillingMod --> SMTP : QR-Bills & DPA Receipts
SchedMod --> SMTP : Wish Links & Schedule Notices
ExportMod ..> ERP : User Downloads .xlsx / .csv
SchedMod --> Obs : Scrubbed Metrics & Errors
Worker --> Obs : Solve Duration & Queue Metrics

@enduml
